---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
---
<Base title="Experience — Ilian Aigner" description="Ilian Aigner's experience in STRK, consultative sales at Horbach, basketball coaching, and entrepreneurship education at the University of Delaware.">
  <header class="page-hero experience-hero shell"><p class="section-label">Experience</p><h1>Practice<br />over theory.</h1><p class="experience-hero-intro">Coaching, lead qualification, customer discovery. Different settings; the same discipline: understand the person before making the pitch.</p><a class="inline-link experience-hero-cv" href="/ilian-aigner-cv.pdf" download>Download my CV <span aria-hidden="true">↓</span></a></header>
  <section class="experience-history shell" aria-labelledby="history-heading"><div class="experience-history-intro"><p class="section-label">Professional experience</p><h2 id="history-heading">The track record.</h2></div><ol class="career-list"><li><div class="career-meta"><strong>Sep 2025–Present</strong><span>Germany / U.S. · Remote</span></div><div class="career-detail"><h3>Co-founder</h3><p class="career-org">STRK</p><p>{profile.interviews} Developed business model canvases and positioning for a fitness coaching app in development and testing.</p><a class="inline-link" href="/work/strk/">View the case study <span aria-hidden="true">↗</span></a></div></li><li><div class="career-meta"><strong>Jun–Aug 2026</strong><span>Hamburg, Germany</span></div><div class="career-detail"><h3>Junior Sales Consultant Intern</h3><p class="career-org">Horbach</p><p>Supported lead qualification, appointment setting, and needs-based financial planning conversations while shadowing senior advisors.</p></div></li><li><div class="career-meta"><strong>Jun 2022–Jan 2025</strong><span>Hamburg, Germany</span></div><div class="career-detail"><h3>Basketball Coach</h3><p class="career-org">Walddörfer SV</p><p>Coached youth teams ages 6–8 and 13–16. Created development plans and mentored players one-on-one.</p></div></li><li><div class="career-meta"><strong>Jun–Aug 2022</strong><span>Hamburg, Germany</span></div><div class="career-detail"><h3>Temporary Assistant</h3><p class="career-org">REWE</p><p>Early customer-facing and team experience in a fast-paced retail setting.</p></div></li></ol></section>
  <section class="education-band shell" aria-labelledby="education-heading"><div><p class="section-label">Education</p><h2 id="education-heading">University of<br />Delaware</h2><span class="education-date">Expected Fall 2028</span></div><div class="education-detail"><h3>Entrepreneurship / Business Administration</h3><p>B.S. with minors in Professional Sales &amp; Sales Management and Marketing.</p><p>Dean’s List, Spring 2025 (semester GPA: 3.875).</p></div></section>
  <section class="experience-programs shell" aria-labelledby="programs-heading"><div><p class="section-label">University of Delaware programs &amp; mentorship</p><h2 id="programs-heading">Learning through doing.</h2></div><ul><li><span>Since Sep 2025</span><strong>VentureOn</strong></li><li><span>Since Mar 2026</span><strong>Executive Peer Mentorship</strong></li><li><span>Since May 2026</span><strong>Siegfried Fellows</strong></li></ul></section>
  <section class="experience-proof shell" aria-labelledby="proof-heading"><p class="section-label">Selected achievements</p><h2 id="proof-heading">Evidence of progress.</h2><div class="experience-proof-grid"><div><strong>Top 20</strong><p>Semi-finalist, Lerner Sales Competition (122 participants).</p></div><div><strong>HubSpot</strong><p>Sales Hub Software course certificate, earned Dec 2025.</p></div></div><div class="experience-capabilities"><div><span>Sales &amp; discovery</span><p>Customer discovery · Lead qualification · Business model canvases</p></div><div><span>Languages</span><p>German · English · French</p></div></div><a class="inline-link experience-cv-link" href="/ilian-aigner-cv.pdf" download>Download one-page CV <span aria-hidden="true">↓</span></a></section>
  <script>
    const career = document.querySelector<HTMLElement>('.career-list');
    if (career && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let queued = false;
      const update = () => {
        queued = false;
        const bounds = career.getBoundingClientRect();
        const start = window.scrollY + bounds.top - window.innerHeight * .55;
        const end = window.scrollY + bounds.bottom - window.innerHeight * .55;
        const progress = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
        career.style.setProperty('--career-progress', String(progress));
        const entries = [...career.querySelectorAll('li')];
        const threshold = window.innerHeight * .55;
        const active = entries.findLastIndex((entry) => entry.getBoundingClientRect().top <= threshold);
        entries.forEach((entry, index) => entry.classList.toggle('is-active', index === Math.max(0, active)));
      };
      const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    }
  </script>
</Base>
