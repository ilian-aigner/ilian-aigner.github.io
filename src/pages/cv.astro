---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
---
<Base title="CV — Ilian Aigner" description="Read or download Ilian Aigner's one-page résumé for U.S. B2B sales, SDR, and BDR internships.">
  <header class="page-hero shell"><p class="section-label">Curriculum vitae</p><h1>The experience.<br />On one page.</h1><p>My résumé for U.S. B2B sales, SDR, and BDR internships. Read it here, open the PDF, or download a copy.</p></header>
  <div class="shell cv-page"><div class="cv-actions"><a class="button button-primary" href="/ilian-aigner-cv.pdf" download>Download one-page PDF ↓</a><a class="button button-outline" href="/ilian-aigner-cv.pdf" target="_blank" rel="noopener">Open PDF ↗</a><button class="button button-outline" onclick="window.print()">Print résumé</button></div><article class="resume" aria-label="Ilian Aigner résumé"><h2>{profile.name}</h2><p class="resume-contact"><a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={profile.linkedin}>LinkedIn</a> · <a href={profile.strk}>STRK</a></p><p>{profile.cv.summary}</p><h3>Education</h3><div class="resume-row"><strong>{profile.university} — {profile.degree}</strong><span>{profile.graduation}</span></div><p class="resume-muted">Minors: {profile.minors}</p><h3>Relevant experience</h3>{profile.cv.experience.map(item => <div><div class="resume-row"><strong>{item.role}, {item.organization}</strong><span>{item.dates}</span></div><p class="resume-muted">{item.location}</p><ul>{item.bullets.map(b => <li>{b}</li>)}</ul></div>)}<h3>Selected achievements &amp; skills</h3><ul>{profile.cv.achievements.map(a => <li>{a}</li>)}</ul><p><strong>Tools &amp; methods:</strong> {profile.cv.tools}</p><p><strong>Languages:</strong> {profile.cv.languages}</p></article></div>
</Base>
