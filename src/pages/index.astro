---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
---
<Base title="Ilian Aigner — B2B Sales, Customer Discovery & STRK" description="Ilian Aigner is a University of Delaware entrepreneurship student and STRK co-founder seeking U.S. B2B sales, SDR, and BDR internships." kind="home">
  <section class="home-hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="hero-kicker"><span class="amber-line"></span><span>University of Delaware · Expected Fall 2028</span></div>
      <h1 id="hero-title">Ilian<br /><span>Aigner</span><b aria-hidden="true">.</b></h1>
      <p class="hero-statement">B2B sales, customer discovery, and building STRK.</p>
      <p class="hero-intro">Entrepreneurship student at the University of Delaware and co-founder of STRK. Seeking U.S. B2B sales, SDR, and BDR internships.</p>
      <div class="action-row"><a class="button button-primary" href="/work/">View my work <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/ilian-aigner-cv.pdf" download>Download CV <span aria-hidden="true">↓</span></a></div>
    </div>
    <figure class="hero-photo"><img src="/assets/images/ilian-portrait-1200.jpg" srcset="/assets/images/ilian-portrait-700.jpg 700w, /assets/images/ilian-portrait-1200.jpg 1200w" sizes="(max-width: 700px) 100vw, 48vw" width="1200" height="1200" alt="Portrait of Ilian Aigner in a dark suit" fetchpriority="high" /><figcaption><span>01 / 05</span><span>Sales · Entrepreneurship · Product</span></figcaption></figure>
    <div class="hero-bottom"><span>Hamburg → Delaware</span><span>Scroll to explore <span aria-hidden="true">↓</span></span></div>
  </section>

  <section class="signal-band" aria-label="Selected profile highlights"><div class="shell signal-inner"><p>{profile.interviews}</p><p>Top 20 Lerner Sales Competition semi-finalist.</p><p>German · English · French</p></div></section>

  <section id="work" class="shell home-section selected-work">
    <div class="section-top"><p class="section-label">Selected work</p><a class="inline-link" href="/work/">All work <span aria-hidden="true">↗</span></a></div>
    <div class="section-heading split-heading"><h2>From questions<br />to direction.</h2><p>Commercial thinking starts with listening. These are the settings where I’ve put that into practice.</p></div>
    <a class="featured-project" href="/work/strk/" aria-label="Read the STRK case study">
      <div class="project-image"><div class="logo-panel"><img src="/assets/images/strk-wordmark-light.svg" width="720" height="300" alt="Current STRK light-mode wordmark" loading="lazy" /></div><span class="project-image-note">CURRENT PROJECT / IN DEVELOPMENT</span></div>
      <div class="project-details"><span class="project-number">01 — STRK</span><h3>Building a better coaching loop.</h3><p>A fitness coaching app in development: personalized plans, AI support for everyday guidance, and optional connected human trainer help.</p><span class="inline-link">Explore the case study <span aria-hidden="true">↗</span></span></div>
    </a>
    <div class="work-pair"><a href="/work/#sales-competition"><span>02 / Sales competition</span><strong>Performing under pressure.</strong><small>Top 20 Lerner semi-finalist ↗</small></a><a href="/work/#consultative-sales"><span>03 / Consultative sales</span><strong>Listening before pitching.</strong><small>Horbach internship ↗</small></a></div>
  </section>

  <section id="approach" class="approach-section"><div class="shell approach-inner"><div><p class="section-label">How I work</p><h2>Curiosity is<br /><em>commercial.</em></h2></div><div class="approach-list"><div><span>01</span><p>Ask before assuming.<small>Discovery makes the next step relevant.</small></p></div><div><span>02</span><p>Separate evidence from a hypothesis.<small>Early research is a starting point, not proof.</small></p></div><div><span>03</span><p>Make the next move useful.<small>Translate what was learned into clearer action.</small></p></div></div></div></section>

  <section id="about" class="shell home-section about-teaser"><div class="section-top"><p class="section-label">Beyond the work</p><a class="inline-link" href="/about/">More about me <span aria-hidden="true">↗</span></a></div><div class="about-teaser-grid"><h2>Across cultures.<br />Across disciplines.</h2><div><p>Hamburg is home; Delaware is where I’m studying entrepreneurship and sharpening my sales craft. Coaching basketball taught me to communicate clearly, adapt to people, and help a team grow.</p><p>I’m drawn to travel, new perspectives, and the conversations that change how a problem looks.</p></div></div></section>

  <section class="contact-section shell"><p class="section-label">Next conversation</p><h2>Looking for a place<br />to contribute early.</h2><div class="contact-line"><div class="email-actions"><a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a><button type="button" id="copy-email" data-email={profile.email} aria-label="Copy email address">Copy address</button><span id="copy-status" role="status" aria-live="polite"></span></div><span>U.S. B2B sales · SDR · BDR internships</span></div></section>
  <script>
    const copy = document.querySelector<HTMLButtonElement>('#copy-email');
    copy?.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('#copy-status');
      try {
        await navigator.clipboard.writeText(copy.dataset.email ?? '');
        if (status) status.textContent = 'Copied';
      } catch {
        if (status) status.textContent = 'Select the address to copy';
      }
    });
  </script>
</Base>
