---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found — Ilian Aigner" description="This page is unavailable. Explore Ilian Aigner's portfolio from the homepage.">
  <section class="shell not-found" aria-labelledby="not-found-title">
    <span class="not-found-number" aria-hidden="true">404</span>
    <div class="not-found-copy">
      <p class="section-label">Page not found</p>
      <h1 id="not-found-title">Wrong turn.<br />Good next step.</h1>
      <p>That link doesn’t lead to a page. The work is still here.</p>
      <div class="not-found-actions">
        <a class="button button-primary" href="/work/">View my work <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="/">Back to home <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
