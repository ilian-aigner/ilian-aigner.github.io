---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/site.css';
import profile from '../data/profile.json';

interface Props {
  title: string;
  description: string;
  kind?: 'home' | 'about' | 'page';
  image?: string;
  imageAlt?: string;
}
const { title, description, kind = 'page', image = '/assets/images/social-preview.png', imageAlt = 'Ilian Aigner, STRK co-founder pursuing U.S. B2B sales internships' } = Astro.props;
const origin = Astro.site?.origin ?? 'https://ilian-aigner.github.io';
const url = new URL(Astro.url.pathname, origin).toString();
const person = {
  '@type': 'Person', '@id': `${origin}/#person`, name: profile.name,
  url: origin, email: `mailto:${profile.email}`, sameAs: [profile.linkedin],
  affiliation: [{ '@type': 'CollegeOrUniversity', name: profile.university }, { '@type': 'Organization', name: 'STRK', url: profile.strk }],
  knowsAbout: ['B2B sales', 'customer discovery', 'entrepreneurship']
};
const labels: Record<string, string> = { work: 'Work', strk: 'STRK', experience: 'Experience', about: 'About', cv: 'CV' };
const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
    ...segments.map((segment, index) => ({
      '@type': 'ListItem', position: index + 2, name: labels[segment] ?? segment,
      item: new URL('/' + segments.slice(0, index + 1).join('/') + '/', origin).toString()
    }))
  ]
};
const page = kind === 'about' ? {
  '@type': 'ProfilePage', mainEntity: { '@id': `${origin}/#person` }, name: title, description, url
} : {
  '@type': 'WebPage', name: title, description, url,
  about: { '@id': `${origin}/#person` },
  isPartOf: { '@type': 'WebSite', name: 'Ilian Aigner', url: origin }
};
const structured = {
  '@context': 'https://schema.org',
  '@graph': [person, page, ...(segments.length ? [breadcrumb] : [])]
};
const nextPages: Record<string, { label: string; href: string; context: string }> = {
  '/about/': { label: 'See the experience', href: '/experience/', context: 'Where those lessons have been put to work' },
  '/experience/': { label: 'Explore the work', href: '/work/', context: 'The projects and conversations behind the résumé' },
  '/work/strk/': { label: 'Read the CV', href: '/cv/', context: 'The full background on one page' },
  '/cv/': { label: 'Start a conversation', href: '/#contact-choices', context: 'Email or connect on LinkedIn' }
};
const nextPage = nextPages[Astro.url.pathname];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // A URL opened with a fragment should land there immediately. Keep smooth
      // scrolling for links clicked after the page has loaded.
      if (location.hash) {
        document.documentElement.style.scrollBehavior = 'auto';
        addEventListener('load', () => {
          const id = decodeURIComponent(location.hash.slice(1));
          document.getElementById(id)?.scrollIntoView({ behavior: 'auto', block: 'start' });
          requestAnimationFrame(() => document.documentElement.style.removeProperty('scroll-behavior'));
        }, { once: true });
      }
    </script>
    <meta name="theme-color" content="#0B0E13" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={kind === 'about' ? 'profile' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image, origin).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, origin).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell" id="top">
      <a class="brand" href="/" aria-label="Ilian Aigner — home">Ilian Aigner<span aria-hidden="true">.</span></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="/work/" aria-current={Astro.url.pathname.startsWith('/work/') ? 'page' : undefined}>Work</a>
        <a href="/experience/" aria-current={Astro.url.pathname === '/experience/' ? 'page' : undefined}>Experience</a>
        <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a>
        <a href="/cv/" aria-current={Astro.url.pathname === '/cv/' ? 'page' : undefined}>CV</a>
        <details class="contact-picker"><summary class="nav-contact">Contact <span aria-hidden="true">＋</span></summary><div class="contact-options"><a href={`mailto:${profile.email}`}><strong>Email me</strong><small>{profile.email}</small></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><strong>Connect on LinkedIn ↗</strong><small>View my profile and message me</small></a></div></details>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Toggle menu">Menu <span aria-hidden="true">＋</span></summary>
        <nav aria-label="Mobile navigation">
          <a href="/work/" aria-current={Astro.url.pathname.startsWith('/work/') ? 'page' : undefined}>Work</a><a href="/experience/" aria-current={Astro.url.pathname === '/experience/' ? 'page' : undefined}>Experience</a>
          <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a><a href="/cv/" aria-current={Astro.url.pathname === '/cv/' ? 'page' : undefined}>CV</a>
          <div class="mobile-menu-contact" aria-label="Contact options"><p>Start a conversation</p><a href={`mailto:${profile.email}`}><strong>Email me</strong><small>{profile.email}</small></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><strong>LinkedIn ↗</strong><small>Connect with me there</small></a></div>
        </nav>
      </details>
    </header>
    <main id="main"><slot /></main>
    {nextPage && <nav class="next-chapter shell" aria-label="Continue exploring"><p>{nextPage.context}</p><a href={nextPage.href}>{nextPage.label}<span aria-hidden="true">↗</span></a></nav>}
    <footer class="site-footer shell">
      <div><a class="footer-name" href="/">Ilian Aigner</a><p>Hamburg roots. Delaware chapter. More to build.</p></div>
      <div class="footer-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={profile.strk} target="_blank" rel="noopener noreferrer">STRK ↗</a><a href={`mailto:${profile.email}`}>Email ↗</a><a href="#top">Back to top ↑</a></div>
      <small>© {new Date().getFullYear()} Ilian Aigner</small>
    </footer>
    <script>
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const opened = [...document.querySelectorAll<HTMLDetailsElement>('.contact-picker[open], .mobile-menu[open]')];
        if (opened.length) { opened.forEach(menu => menu.open = false); opened[0].querySelector('summary')?.focus(); }
      });
      document.addEventListener('click', (event) => {
        document.querySelectorAll<HTMLDetailsElement>('.contact-picker[open], .mobile-menu[open]').forEach(picker => {
          if (!picker.contains(event.target as Node)) picker.open = false;
        });
      });
    </script>
  </body>
</html>
